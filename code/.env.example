# ============================================
# Sentinel — Variables d'environnement
# ============================================
# Copier ce fichier en .env et adapter les valeurs

# Django
SECRET_KEY=changeme-generate-with-get-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# HMAC — Clé TOTALEMENT séparée de SECRET_KEY (ADR-07)
# Une rotation de SECRET_KEY ne doit JAMAIS invalider les sceaux HMAC existants
HMAC_SECRET_KEY=changeme-generate-separate-hmac-key

# PostgreSQL
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel_dev_password
DATABASE_URL=postgres://sentinel:sentinel_dev_password@db:5432/sentinel

# Email (Story 4.3 — canal « alarme incendie »)
# Le canal e-mail est désactivé par défaut. Deux configurations possibles :
#
# 1) DEV avec Mailpit (serveur SMTP local de test, UI sur http://localhost:8025) :
#    EMAIL_NOTIFICATIONS_ENABLED=True
#    EMAIL_HOST=localhost          # ou "mailpit" si lancé via docker compose
#    EMAIL_PORT=1025
#    EMAIL_USE_TLS=False
#
# 2) PRODUCTION, le jour où la BICEC fournit ses SMTP : renseigner les valeurs
#    ci-dessous et passer EMAIL_NOTIFICATIONS_ENABLED=True. Aucun code à changer.
EMAIL_NOTIFICATIONS_ENABLED=False
EMAIL_HOST=smtp.bicec.internal
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=sentinel@bicec.cm
# URL de base pour les liens absolus dans les e-mails
SITE_BASE_URL=http://localhost:8000

# Gunicorn
GUNICORN_WORKERS=4
GUNICORN_THREADS=10
