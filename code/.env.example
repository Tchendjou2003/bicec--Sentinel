# ============================================
# Sentinel — Variables d'environnement
# ============================================
# Copier ce fichier en .env et adapter les valeurs

# Django
SECRET_KEY=changeme-generate-with-get-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# HMAC — Clé TOTALEMENT séparée de SECRET_KEY (ADR-07)
# Une rotation de SECRET_KEY ne doit JAMAIS invalider les sceaux HMAC existants
HMAC_SECRET_KEY=changeme-generate-separate-hmac-key

# PostgreSQL
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel_dev_password
DATABASE_URL=postgres://sentinel:sentinel_dev_password@db:5432/sentinel

# Email (SMTP BICEC)
EMAIL_HOST=smtp.bicec.internal
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=sentinel@bicec.cm

# Gunicorn
GUNICORN_WORKERS=4
GUNICORN_THREADS=10
